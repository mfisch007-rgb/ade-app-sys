# =====================================================================
# ADE — ENVIRONMENT CONTRACT
#
# Copy to .env for local development.
# Never commit real credentials or production secrets.
# Hosting platforms should provide production values through their
# environment-variable configuration.
# =====================================================================

# Node HTTP listener port.
# The canonical launcher is src/server.js.
PORT=3000

# ADE runtime edition/operating mode.
# Allowed values (single source of truth: src/app.js
# ADE_RUNTIME_MODE_CONTRACT):
# FULL
# COMMUNITY
# PILOT
# PROFESSIONAL
# ENTERPRISE
# SYSTEM
# DEMO
#
# Compatibility alias: FULL == COMMUNITY (an alias mapping lives in
# src/core/EditionPolicy.js). Other modes are accepted by the server and
# resolved by the same EditionPolicy authority.
# ADE_RUNTIME_MODE=FULL

# Explicit UI/UX demonstration mode flag. When true (or when
# ADE_EDITION=DEMO), the DemoSafetyBoundary enforces real controlled
# operating limits: no production credentials, no real external
# integrations, no irreversible actions, traceable demo execution IDs.
ADE_DEMO_MODE=false

# Explicit edition override (used by CommunityEditionGuard / DemoSafetyBoundary).
# Values follow the same contract as ADE_RUNTIME_MODE above.
# ADE_EDITION=COMMUNITY

# Capability registry state location.
#
# The default (local) implementation is filesystem-backed and therefore
# suitable for local/development or persistent container volumes.
ADE_CAPABILITY_STORE=.ade_capability_store.json

# ---------------------------------------------------------------------
# PORTABLE/ DURABLE STORAGE (G17)
#
# ADE exposes a canonical StorageProvider contract with a callable
# factory: createStorageProvider().
#
#   provider=local     -> LocalStorageAdapter (filesystem)  [default/dev]
#   provider=supabase  -> SupabaseStorageAdapter (durable/external)
#
# Durable adapters NEVER fabricate credentials. If the required
# environment values are absent, the adapter fails safely with
# STORAGE_NOT_CONFIGURED instead of degrading silently.
# ---------------------------------------------------------------------
# ADE_STORAGE_PROVIDER=local
#
# When ADE_STORAGE_PROVIDER=supabase, supply all three (server-side only,
# never exposed to client bundles, never committed):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=<supabase backend secret key> (preferred; aliases:
#   SUPABASE_SERVICE_ROLE_KEY, SUPABASE_STORAGE_KEY)
# SUPABASE_STORAGE_TABLE=ade_kv_store (table with columns k text pk, v jsonb;
#   see database/supabase-production-schema.sql, no manual SQL required
#   beyond applying the checked-in migration through the supported route)

# ---------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Resend — canonical server-side path)
#
# Production project: <resend-project> (Resend integration already
# authorized; do NOT create another integration). Sender domain:
# example.com
# Preferred sender: ADE <notifications@example.com>
# Server-side only: never expose RESEND_API_KEY to client bundles, logs,
# or commits. Until configured, notifications remain internal events only.
# ---------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_SENDER=ADE <notifications@example.com>

# ---------------------------------------------------------------------
# PRODUCT THEATRE / MEDIA CONSOLE
#
# Founder + top-admin structural CMD console (see src/media/MediaEngine.js).
# Artefacts self-purge after 7 days to protect memory. SEND/EXTRACT always
# requires a fresh founder/admin PIN via CredentialLifecycleStore.
# No extra configuration required; retention is fixed at 7 days by design.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# HTTP ADMIN AUTHENTICATION
#
# Generate a bcrypt hash with:
# node scripts/generate-admin-pin-hash.mjs
#
# Store the resulting hash in local/hosting environment configuration.
# Never commit a real hash or plaintext PIN.
# ---------------------------------------------------------------------
ADE_ADMIN_PIN_HASH=
ADE_ADMIN_SESSION_LEVEL=2

# Optional bcrypt recovery credential hash.
ADE_ADMIN_RECOVERY_KEY_HASH=

# ---------------------------------------------------------------------
# SIGNED-SESSION / PRIVATE KEY MATERIAL
#
# The runtime identity (src/kernel/IdentityOnboarding.js) signs admin
# sessions with an RSA key. Resolve keys in one of two ways:
#
# 1) ENV-VAR MODE (preferred for serverless): export both values as
#    PEM strings. All lines including BEGIN/END headers MUST be on a
#    single line (use \n literal escapes when embedding in JSON).
#    When set, the filesystem key files are ignored.
# ADE_PUBLIC_KEY=
# ADE_PRIVATE_KEY=
#
# 2) FILESYSTEM MODE (local/development default): place keys under the
#    runtime path resolved by src/security/KeyManager.js. The private
#    key file is enforced at mode 0o600 (owner read/write only). The
#    filesystem is never used when ADE_PRIVATE_KEY is present.

# Signed-session lifetime and claim contract (src/kernel/IdentityOnboarding.js).
# Sessions are signed JWT-style claims validated against issuer + audience.
# ADE_SESSION_TTL_SECONDS=3600
# ADE_SESSION_REVOCATION_FILE=.ade_session_revocations.json
# ADE_TOKEN_ISSUER=ADE-APEX
# ADE_TOKEN_AUDIENCE=ADE-APEX-RUNTIME

# Credential lifecycle store (rotated credentials, revocation state).
# Filesystem-backed by default; values identical to the env contract above.
# Default matches src/security/CredentialLifecycleStore.js
# ("data/admin-credential.json"). Do not change the production path until
# persistence/compatibility review; override only via environment.
# ADE_CREDENTIAL_STORE_FILE=data/admin-credential.json
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# FEEDBACK PIPELINE PERSISTENCE
#
# The kernel feedback pipeline (src/kernel/FeedbackPipeline.js) persists
# captured feedback atomically (tmp + rename) to this file. Persistence
# failures are swallowed — they never break intake or kernel boot.
# ---------------------------------------------------------------------
ADE_FEEDBACK_QUEUE=.ade_feedback_queue.json

# ---------------------------------------------------------------------
# OPTIONAL AI PROVIDERS (G20 — provider-neutral contract)
#
# ADE's canonical AI authority is src/ai/UniversalAIGateway.js. It is a
# provider-neutral gateway: providers are selected deterministically in
# declaration order and only when the matching key is present.
#
# AI is OPTIONAL for ADE Community. It is never required for kernel boot,
# intake, case processing, EventBus, tests, build, or any core operation.
#
# Each provider is configured through its own environment key. An
# unconfigured provider is skipped honestly; it is NEVER reported as a
# successful external connection. If NO provider is configured (or every
# configured provider fails real HTTP/network calls), the gateway falls
# back to the ADE offline lexical engine, which is labelled honestly as
# deterministic / offline — it never masquerades as live external AI.
#
# Configure only the providers you actually use. Leave the rest empty.
# Never commit real keys.
# ---------------------------------------------------------------------
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
#
# Optional deterministic routing override (FULL, COMMUNITY, PILOT,
# PROFESSIONAL, ENTERPRISE, SYSTEM, DEMO). The gateway honours
# Community-operation semantics when AI is unconfigured; it never
# requires AI for the Community edition.
# ADE_AI_MODE=COMMUNITY

# Semantic-cache bound for the AI gateway (entries). Bounded at runtime;
# LRU-style eviction observed at the configured cap.
# ADE_AI_CACHE_MAX_SIZE=1000

# ---------------------------------------------------------------------
# RATE LIMITING / HTTP SECURITY
#
# Fixed-window per-client burst limiter (src/security/RateLimiter.js)
# applies to authentication-sensitive endpoints. The limiter is always
# bounded in memory.
# ADE_RATE_LIMIT_MAX=20
# ADE_RATE_LIMIT_WINDOW_MS=60000
# ADE_AUTH_RATE_LIMIT_MAX=10
# ADE_AUTH_RATE_LIMIT_WINDOW_MS=60000
# ADE_TRUST_PROXY=false

# ---------------------------------------------------------------------
# OPTIONAL RESOURCE BOUNDS
#
# Bounded in-memory request registries. Override only when the default
# is insufficient for your deployment.
# ADE_MEDIA_MAX_REQUESTS=5000

# ---------------------------------------------------------------------
# LEGACY / NON-CANONICAL MODULES
#
# The canonical runtime and launcher (src/app.js + src/server.js) do NOT
# mount the legacy subscription/redis/whatsapp route stacks. Variables
# consumed by those non-canonical modules (e.g. REDIS_URL,
# ADMIN_SECURITY_PIN, JWT_SECRET, PIN_PEPPER, SUBSCRIPTION_SALT,
# RATE_LIMIT_MESSAGES, ADMIN_PHONE, PAYSTACK_SECRET_KEY,
# SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, GCP_*, GOOGLE_ADK_*,
# UNITOOL_/HEYGEN_/GOOGLE_MEDIA_*, DEFAULT_VIDEO_PROVIDER,
# PAIRING_PHONE) are effectively dead configuration in the canonical
# Community runtime and are NOT part of the supported setup contract.
#