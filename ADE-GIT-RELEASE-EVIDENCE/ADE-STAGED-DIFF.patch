+  for (const key of scalarKeys) {
+    if (patch[key] !== undefined) {
+      runtimeState[key] = patch[key];
+    }
+  }
+
+  if (Array.isArray(patch.failures)) {
+    runtimeState.failures = patch.failures;
+  }
