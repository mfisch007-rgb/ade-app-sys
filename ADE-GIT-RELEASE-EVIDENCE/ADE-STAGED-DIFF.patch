+export class DecisionEngine extends EngineBase {
+  constructor({
+    kernel = null,
+    memory = null,
+    knowledge = null,
+    policy = {}
+  } = {}) {
+    super({ kernel });
+    this.memory = memory;
+    this.knowledge = knowledge;
+    this.policy = {
+      approveThreshold: 0.8,
+      holdThreshold: 0.5,
