+
+export function updateRuntimeState(patch = {}) {
+
+  if (patch.services) {
+    runtimeState.services = {
+      ...runtimeState.services,
+      ...patch.services
+    };
+  }
+
+  if (patch.metrics) {
+    runtimeState.metrics = {
+      ...runtimeState.metrics,
+      ...patch.metrics
+    };
+  }
+
+  if (patch.health) {
+    runtimeState.health = {
+      ...runtimeState.health,
+      ...patch.health
+    };
+  }
